# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Environments
.venv/
venv/
env/

# Raw datasets: public, downloaded via scripts/prepare_data.py (see README)
/data/

# Outputs: track the result artifacts (evidence for every reported number) but not
# the 696 MB of checkpoints (regenerable) or the regenerable annotation image copies.
outputs/*
!outputs/.gitkeep
!outputs/*.json
!outputs/*.txt
!outputs/*.png
!outputs/annotation
outputs/annotation/*/images/
outputs/annotation/*.zip

outputs_leaky/
outputs_quick/
*.pth
*.pt
*.ckpt

# Run logs (kept locally, not in git)
logs/

# OS / editor
.DS_Store
.idea/

# Tooling caches
.ruff_cache/

# Keep shared VSCode config, ignore the rest
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
